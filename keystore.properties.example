# Copie este arquivo para "keystore.properties" (sem o .example) e preencha com suas
# credenciais reais. O arquivo "keystore.properties" está no .gitignore — nunca deve
# ser commitado.
#
# Alternativa para CI/CD: defina as variáveis de ambiente TASKFLOW_STORE_FILE,
# TASKFLOW_STORE_PASSWORD, TASKFLOW_KEY_ALIAS e TASKFLOW_KEY_PASSWORD (ex.: como
# secrets do GitHub Actions) em vez de usar este arquivo.

storeFile=/path/to/your/release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
